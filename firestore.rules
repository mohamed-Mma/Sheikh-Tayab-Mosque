rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // أسئلة الزوار - أي حد يقدر يضيف سؤال، والقراءة للوحة التحكم
    match /questions/{questionId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true; // للشيخ من لوحة التحكم
    }

    // الدروس - قراءة للجميع، كتابة من لوحة التحكم
    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // الأخبار
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
